{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cfsystem-redirect",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-17",
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "cfsystem.darcygraphix.com",
      "custom_domain": true,
    },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://darcygraphix.com",
    "SYSTEM_ORIGIN": "https://system.darcygraphix.com",
  },
}
