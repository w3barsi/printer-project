{
  "name": "printer-project",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n backend,storefront,system -c blue,green,magenta \"pnpm --filter @dg/backend dev\" \"pnpm --filter @dg/storefront dev\" \"pnpm --filter @dg/system dev\"",
    "build": "pnpm build:backend && pnpm build:storefront && pnpm build:system",
    "build:backend": "pnpm --filter @dg/backend codegen",
    "build:storefront": "pnpm --filter @dg/storefront build",
    "build:system": "pnpm --filter @dg/system build",
    "deploy:backend": "node scripts/deploy.mjs backend",
    "deploy:cfsystem": "node scripts/deploy.mjs cfsystem",
    "deploy:storefront": "node scripts/deploy.mjs storefront",
    "deploy:system": "node scripts/deploy.mjs system",
    "cf:typegen": "pnpm --filter @dg/storefront --filter @dg/system cf:typegen",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format && pnpm lint",
    "prepare": "husky",
    "deps": "pnpx taze@latest -Ilw",
    "deps:major": "pnpx taze@latest major -Ilw",
    "env": "node sync-env.js",
    "env:prod": "node sync-env.js --prod",
    "ui": "pnpm --filter @dg/ui ui",
    "dryrun": "pnpm --filter @dg/backend dry-run"
  },
  "devDependencies": {
    "convex": "^1.42.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "deployedAt": {
    "backend": "a91ceff7ba717ec48dce559748a392bed7880746",
    "system": "a91ceff7ba717ec48dce559748a392bed7880746"
  },
  "intent": {
    "skills": [
      "@tanstack/react-query",
      "@tanstack/react-router",
      "@tanstack/react-start"
    ]
  }
}
