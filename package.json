{
  "name": "printer-project",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:backend && pnpm build:public && pnpm build:system",
    "build:backend": "pnpm --filter @dg/backend codegen",
    "build:public": "pnpm --filter @dg/public build",
    "build:system": "pnpm --filter @dg/system build",
    "deploy:backend": "pnpm --filter @dg/backend run deploy",
    "deploy:cfsystem": "pnpm --filter @dg/cfsystem-redirect run deploy",
    "deploy:public": "pnpm --filter @dg/public run deploy",
    "deploy:system": "pnpm --filter @dg/system run deploy",
    "cf:typegen": "pnpm --filter @dg/public --filter @dg/system cf:typegen",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format && pnpm lint",
    "prepare": "husky",
    "deps": "pnpx taze@latest -Ilw",
    "deps:major": "pnpx taze@latest major -Ilw",
    "env": "node sync-env.js",
    "env:prod": "node sync-env.js --prod",
    "ui": "pnpm --filter @dg/ui ui",
    "dryrun": "pnpm --filter @dg/backend dry-run"
  },
  "devDependencies": {
    "convex": "^1.42.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "intent": {
    "skills": [
      "@tanstack/react-query",
      "@tanstack/react-router",
      "@tanstack/react-start"
    ]
  }
}
