{
  "name": "@dg/storefront",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000 --host",
    "build": "vite build",
    "build:cf": "CLOUDFLARE_DEPLOY=true vite build --mode prod",
    "start": "node .output/server/index.mjs",
    "deploy": "CLOUDFLARE_DEPLOY=true vite build --mode prod && wrangler deploy",
    "dry-run": "CLOUDFLARE_DEPLOY=true vite build --mode prod && wrangler deploy --dry-run",
    "cf:tail": "wrangler tail --config wrangler.jsonc",
    "cf:typegen": "wrangler types --config wrangler.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@convex-dev/react-query": "0.1.0",
    "@dg/backend": "workspace:*",
    "@dg/drive": "workspace:*",
    "@dg/ui": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "convex": "^1.46.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.525.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hotkeys-hook": "^5.3.3",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@cloudflare/vite-plugin": "^1.42.3",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vite-tsconfig-paths": "^5.1.4",
    "wrangler": "^4.105.0"
  }
}
